import cv2
import os
import numpy as np

# =========================
# CONFIG
# =========================
sets = ["Set 1", "Set 2", "Set 3"]
base_input_dir = "WeldGapImages"

script_dir = os.path.dirname(os.path.abspath(__file__))

# =========================
# PARAMETERS
# =========================
y_center = 70
margin = 50

# thresholds per set
score_thresholds = {
    "Set 1": 40,
    "Set 2": 50,
    "Set 3": 60
}

# =========================
# PROCESS EACH SET
# =========================
for set_name in sets:

    print(f"\nProcessing {set_name}...")

    input_path = os.path.join(script_dir, base_input_dir, set_name)

    interim_dir = f"InterimResultsOf{set_name.replace(' ', '')}"
    interim_path = os.path.join(script_dir, interim_dir)
    os.makedirs(interim_path, exist_ok=True)

    output_csv = f"PositionResultsOf{set_name.replace(' ', '')}.csv"
    csv_path = os.path.join(script_dir, output_csv)

    results = []

    image_list = sorted(os.listdir(input_path))

    for image_name in image_list:
        if not image_name.lower().endswith(".jpg"):
            continue

        img_path = os.path.join(input_path, image_name)
        img = cv2.imread(img_path)

        if img is None:
            continue

        height, width = img.shape[:2]

        # =========================
        # ROI
        # =========================
        roi = img[y_center-5:y_center+5, :]
        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        blur = cv2.GaussianBlur(gray, (5, 5), 0)

        # =========================
        # SOBEL X (KEY STEP)
        # =========================
        sobelx = cv2.Sobel(blur, cv2.CV_64F, 1, 0, ksize=3)
        sobelx = np.mean(sobelx, axis=0)  # collapse to 1D

        # =========================
        # FIND EDGE PAIRS
        # =========================
        best_pair = None
        best_score = 0

        for i in range(margin, width - margin - 10):

            # left edge = strong negative gradient
            if sobelx[i] < -5:

                for j in range(i+3, min(i+15, width - margin)):

                    # right edge = strong positive gradient
                    if sobelx[j] > 5:

                        gap_width = j - i

                        # enforce weld gap width (~6 px)
                        if 4 <= gap_width <= 10:

                            score = abs(sobelx[i]) + abs(sobelx[j])

                            if score > best_score:
                                best_score = score
                                best_pair = (i, j)

        # =========================
        # FINAL DECISION
        # =========================
        threshold = score_thresholds[set_name]

        if best_pair is not None and best_score > threshold:
            x_position = int((best_pair[0] + best_pair[1]) / 2)
            valid = 1
        else:
            x_position = -1
            valid = 0

        # =========================
        # VISUALISATION
        # =========================
        result_img = img.copy()

        if valid == 1:
            cv2.line(result_img, (x_position, 0), (x_position, height), (0, 255, 0), 2)

        # =========================
        # DEBUG: Sobel profile image
        # =========================
        sobel_img = np.zeros((200, width), dtype=np.uint8)

        s = sobelx - np.min(sobelx)
        if np.max(s) != 0:
            s = s / np.max(s) * 199

        for x in range(width):
            y = int(s[x])
            cv2.circle(sobel_img, (x, 199 - y), 1, 255, -1)

        if best_pair is not None:
            cv2.line(sobel_img, (best_pair[0], 0), (best_pair[0], 199), 255, 1)
            cv2.line(sobel_img, (best_pair[1], 0), (best_pair[1], 199), 255, 1)

        # =========================
        # SAVE INTERIM
        # =========================
        base_name = image_name.replace(".jpg", "")

        roi_large = img[y_center-20:y_center+20, :]
        roi_vis = roi_large.copy()

        if valid == 1:
            cv2.line(roi_vis, (x_position, 0), (x_position, roi_large.shape[0]), (0, 255, 0), 2)

        cv2.imwrite(os.path.join(interim_path, f"{base_name}_A_WeldGapPosition.jpg"), roi_vis)
        cv2.imwrite(os.path.join(interim_path, f"{base_name}_B_sobel.jpg"), sobel_img)

        # =========================
        # STORE RESULT
        # =========================
        results.append(f"{image_name}, {x_position}, {valid}")

        print(f"{set_name} | {image_name} → x: {x_position}, valid: {valid}, score: {best_score:.2f}")

    # =========================
    # SAVE CSV
    # =========================
    with open(csv_path, "w") as f:
        f.write("ImageName, Weld gap position in pixel/integer , Weld gap position valid? 0 = false, 1 = true\n")
        for line in results:
            f.write(line + "\n")

    print(f"{set_name} complete.")

print("\nAll sets processed.")
