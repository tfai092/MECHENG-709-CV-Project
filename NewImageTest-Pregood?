import cv2
import os
import numpy as np

# --- Input ---
input_dir = "WeldGapImages/Set 1"
output_dir = "TestOutput"

# Paths
script_dir = os.path.dirname(os.path.abspath(__file__))
input_path = os.path.join(script_dir, input_dir)
output_path = os.path.join(script_dir, output_dir)

if not os.path.exists(output_path):
    os.makedirs(output_path)

# --- Get first image ---
image_list = sorted(os.listdir(input_path))
image_name = next((n for n in image_list if n.lower().endswith(".jpg")), None)

if image_name is None:
    print("No JPG images found.")
    exit()

print(f"Testing on: {image_name}")

img_path = os.path.join(input_path, image_name)
img = cv2.imread(img_path)

if img is None:
    print("Failed to load image.")
    exit()

height, width = img.shape[:2]

# ROI and preprocessing
y_center = 70
roi = img[y_center-5:y_center+5, :]

# =========================
# STEP 2: GRAYSCALE
# =========================
gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)

# =========================
# STEP 3: CLAHE (keep yours)
# =========================
clahe = cv2.createCLAHE(clipLimit=3, tileGridSize=(16, 16))
enhanced = clahe.apply(gray)

# =========================
# STEP 4: BLUR (reduce noise)
# =========================
blur = cv2.GaussianBlur(enhanced, (5, 5), 0)

# =========================
# STEP 5: PROFILE (KEY STEP)
# =========================
profile = np.mean(blur, axis=0)

# normalize
profile = profile - np.mean(profile)

# smooth profile
profile_smooth = cv2.GaussianBlur(profile.reshape(1, -1), (1, 9), 0).flatten()

# =========================
# STEP 6: FIND GAP
# =========================
x_candidate = np.argmin(profile_smooth)

# =========================
# STEP 7: VALIDATION
# =========================
window = 10
left = max(0, x_candidate - window)
right = min(len(profile_smooth), x_candidate + window)

local_avg = np.mean(profile_smooth[left:right])
contrast = local_avg - profile_smooth[x_candidate]

contrast_threshold = 5

if contrast > contrast_threshold:
    x_position = int(x_candidate)
    valid = 1
else:
    x_position = -1
    valid = 0

# Visualize on ROI strip
line_vis = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)

if valid == 1:
    cv2.line(line_vis, (x_candidate, 0), (x_candidate, roi.shape[0]), (0, 255, 0), 2)
else:
    cv2.line(line_vis, (roi.shape[1]//2, 0), (roi.shape[1]//2, roi.shape[0]), (0, 0, 255), 2)

# =========================
# FINAL RESULT ON FULL IMAGE
# =========================
result_img = img.copy()

if valid == 1:
    cv2.line(result_img, (x_position, 0), (x_position, height), (0, 255, 0), 2)
else:
    cv2.line(result_img, (width//2, 0), (width//2, height), (0, 0, 255), 2)

# =========================
# PROFILE IMAGE (DEBUG)
# =========================
profile_img = np.zeros((200, width), dtype=np.uint8)

p = profile_smooth - np.min(profile_smooth)
p = p / np.max(p) * 199

for x in range(width):
    y = int(p[x])
    cv2.circle(profile_img, (x, 199 - y), 1, 255, -1)

cv2.line(profile_img, (x_candidate, 0), (x_candidate, 199), 255, 1)

# =========================
# SAVE ALL STAGES
# =========================
base_name = image_name.replace(".jpg", "")

cv2.imwrite(os.path.join(output_path, f"{base_name}_1_roi.jpg"), roi)
cv2.imwrite(os.path.join(output_path, f"{base_name}_2_gray.jpg"), gray)
cv2.imwrite(os.path.join(output_path, f"{base_name}_3_enhanced.jpg"), enhanced)
cv2.imwrite(os.path.join(output_path, f"{base_name}_4_blur.jpg"), blur)
cv2.imwrite(os.path.join(output_path, f"{base_name}_5_profile.jpg"), profile_img)
cv2.imwrite(os.path.join(output_path, f"{base_name}_6_detection.jpg"), line_vis)
cv2.imwrite(os.path.join(output_path, f"{base_name}_7_result.jpg"), result_img)

print(f"x_position: {x_position}, valid: {valid}, contrast: {contrast:.2f}")
print(f"Test complete. Check {output_path} folder.")
